# Demo-only values for local Docker demo in China mainland networks.
# Copy to .env; do not reuse these secrets in production.

MYSQL_HOST_PORT=3307
MYSQL_DATABASE=intelligent_outfit
MYSQL_ROOT_PASSWORD=123456

REDIS_HOST_PORT=6379

RABBITMQ_AMQP_HOST_PORT=5672
RABBITMQ_MANAGEMENT_HOST_PORT=15672
RABBITMQ_PROMETHEUS_HOST_PORT=15692
RABBITMQ_USERNAME=app
RABBITMQ_PASSWORD=app-dev-password

LANGGRAPH_POSTGRES_HOST_PORT=5433
LANGGRAPH_POSTGRES_DATABASE=langgraph
LANGGRAPH_POSTGRES_USERNAME=langgraph
LANGGRAPH_POSTGRES_PASSWORD=change-me-locally
LANGGRAPH_CHECKPOINTER_BACKEND=postgres

ELASTICSEARCH_HOST_PORT=9200
KIBANA_HOST_PORT=5601

JAVA_BACKEND_HOST_PORT=8080
PYTHON_AI_HOST_PORT=8000
FRONTEND_HOST_PORT=3000

PYTHON_AI_CONTEXT=../AI-Clothing-Shopping-Assistant-System
MYSQL_IMAGE=m.daocloud.io/docker.io/library/mysql:8.0
REDIS_IMAGE=m.daocloud.io/docker.io/library/redis:7.2
RABBITMQ_IMAGE=m.daocloud.io/docker.io/library/rabbitmq:4.1.8-management
LANGGRAPH_POSTGRES_IMAGE=m.daocloud.io/docker.io/library/postgres:16
ELASTICSEARCH_IMAGE=elastic.m.daocloud.io/elasticsearch/elasticsearch:9.4.3
KIBANA_IMAGE=elastic.m.daocloud.io/kibana/kibana:9.4.3
CURL_IMAGE=m.daocloud.io/docker.io/curlimages/curl:8.11.1
JDK_BASE_IMAGE=m.daocloud.io/docker.io/library/eclipse-temurin:21-jdk-jammy
JRE_BASE_IMAGE=m.daocloud.io/docker.io/library/eclipse-temurin:21-jre-jammy
NODE_BASE_IMAGE=m.daocloud.io/docker.io/library/node:22-alpine
NGINX_BASE_IMAGE=m.daocloud.io/docker.io/library/nginx:1.27-alpine
PYTHON_BASE_IMAGE=m.daocloud.io/docker.io/library/python:3.12-slim
MAVEN_REPO_URL=https://maven.aliyun.com/repository/public
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn

APP_INTERNAL_API_TOKEN=demo-internal-token-change-me
APP_JWT_SECRET=demo-jwt-secret-change-before-production-2026
APP_PAYMENT_ALIPAY_CALLBACK_SECRET=demo-alipay-callback-secret
APP_PAYMENT_WECHAT_CALLBACK_SECRET=demo-wechat-callback-secret

APP_RECOMMENDATION_ES_RECALL_ENABLED=true
APP_PRODUCT_SEARCH_SYNC_ENABLED=true
APP_PRODUCT_SEARCH_SYNC_PUBLISHER_ENABLED=true
APP_PRODUCT_SEARCH_SYNC_LISTENER_ENABLED=true
APP_AI_TASK_PUBLISHER_ENABLED=true
APP_AI_TASK_LISTENER_ENABLED=true

AI_RUNTIME_ENV=development
JINA_API_KEY=
JINA_EMBEDDING_MODEL=jina-embeddings-v4
MOONSHOT_API_KEY=
KIMI_CHAT_MODEL=kimi-k2.5
ENABLE_LLM_PREFERENCE_MAPPER=false
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_CONCURRENCY=8
RAG_TIMEOUT_SECONDS=20
STREAM_SAFETY_TAIL_CHARS=64
